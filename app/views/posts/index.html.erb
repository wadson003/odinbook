<h1>Mon Fil d'actualite</h1>

<%= form_with model: (@post || Post.new), local: true do |f| %>
  <div>
    <%= f.label :body, "Quoi de neuf ?" %><br>
    <%= f.text_area :body, placeholder: "Exprimez-vous..." %>
  </div>
  <%= f.submit "Publier" %>
<% end %>

<hr>

<div class="feed">
  <% @posts.each do |post| %>
    <div class="post" style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
      
      <p><strong><%= post.author.full_name %></strong> (le <%= post.created_at.strftime("%d/%m/%Y") %>)</p>
      <p><%= post.body %></p>

      <hr>

      <div class="likes-section">
        <p><%= post.likes.count %> J'aime</p>
        
        <% existing_like = post.likes.find_by(user: current_user) %>
        <% if existing_like %>
          <%= button_to "Je n'aime plus", post_like_path(post, existing_like), method: :delete, style: "color: red;" %>
        <% else %>
          <%= button_to "J'aime", post_likes_path(post), method: :post %>
        <% end %>
      </div>

      <hr>

      <div class="comments-section" style="margin-top: 15px;">
        <h3>Commentaires (<%= post.comments.count %>)</h3>
        
        <% post.comments.each do |comment| %>
          <% if comment.persisted? %>
            <div class="comment" style="background: #f9f9f9; padding: 5px 10px; margin-bottom: 5px; border-radius: 3px;">
              <p style="margin: 0;"><strong><%= comment.author.full_name %> :</strong> <%= comment.body %></p>
            </div>
          <% end %>
        <% end %>

        <div style="margin-top: 10px;">
          <%= form_with(model: [post, Comment.new], local: true) do |f| %>
            <%= f.text_field :body, placeholder: "Ajouter un commentaire...", style: "width: 70%; padding: 5px;" %>
            <%= f.submit "Commenter" %>
          <% end %>
        </div>
      </div>

    </div>
  <% end %>
</div>