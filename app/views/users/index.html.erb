<h1> Tous les utilisateurs </h1>

<ul>
    <% @users.each do |user| %>
     <li>
        <%= link_to user.full_name, user_path(user) %>

        <% friendship = Friendship.find_by(sender: current_user, receiver: user) || Friendship.find_by(sender: user, receiver: current_user) %>

        <% if friendship.nil?%>
          <%= button_to "Suivre / Ajouter", friendship_path(receiver_id: user.id), method: :post %>
        <% elsif friendship.status == 'pending' && friendship.sender == current_user %>
          <span>Demande en attente...</span>
        <% elsif friendship.status == 'pending' && friendship.sender == current_user %>
          <%= button_to "Accepter l'invitation", friendship_path(friendship), method: patch %>
        <% else %>
          <span> vous etes amis </span>
        <% end %>
     </li>
    <% end %>
</ul>
<h1>Découvrir d'autres utilisateurs</h1>

<div class="users-list">
  <% @users.each do |user| %>
    <div class="user-card" style="border: 1px solid #ddd; padding: 10px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h3><%= link_to user.full_name, user_path(user) %></h3>
        <p><%= user.email %></p>
      </div>

      <div>
      
        <% friendship = current_user.sent_friendships.find_by(receiver_id: user.id) || current_user.received_friendships.find_by(sender_id: user.id) %>

        <% if friendship.nil? %>
          <%= button_to "Suivre / Ajouter", friendships_path(receiver_id: user.id), method: :post %>
        <% elsif friendship.status == 'pending' && friendship.sender_id == current_user.id %>
          <span style="color: orange; font-style: italic;">Demande en attente...</span>
        <% elsif friendship.status == 'pending' && friendship.receiver_id == current_user.id %>
          <%= button_to "Accepter l'invitation", friendship_path(friendship, status: 'accepted'), method: :patch %>
        <% else %>
          <span style="color: green; font-weight: bold;">✓ Ami</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>